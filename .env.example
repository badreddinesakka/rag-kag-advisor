# Copiez ce fichier sous le nom « .env » et remplissez-le.
#
#   Windows PowerShell :  Copy-Item .env.example .env
#   Linux, macOS       :  cp .env.example .env
#
# Le fichier .env n'est PAS versionné : il contient un mot de passe.
# Ce fichier-ci l'est, pour que chacun sache quoi remplir.

# Mot de passe de Neo4j.
# Lu par docker-compose.yml au démarrage du conteneur.
# Les scripts Python le cherchent dans la variable d'environnement du même nom,
# à définir séparément dans votre terminal :
#     $env:NEO4J_PASSWORD = "..."      (PowerShell)
#     export NEO4J_PASSWORD="..."      (bash)
NEO4J_PASSWORD=changez_moi
